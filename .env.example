# docker compose 环境变量模板:复制为 .env 后填写

# biliup 后端地址(必填,按你实际部署填;不一定是 19159)
#   - biliup 跑在宿主机: http://host.docker.internal:19159
#   - biliup 是另一个容器: http://<容器名>:19159
#   - biliup 在远程: http://<IP>:<端口>
BILIUP_BASEURL=http://host.docker.internal:19159

# notify 网页端端口
NOTIFY_HOST_ADDRESS=0.0.0.0
NOTIFY_PORT=4000

# Telegram 配置(可选,也可之后在网页端配置)
TELEGRAM_ENABLED=false
TELEGRAM_BOTTOKEN=
TELEGRAM_CHATIDS=

# 出站代理(直连 Telegram 不通时填,如 http://host.docker.internal:7890)
NOTIFY_PROXY=
